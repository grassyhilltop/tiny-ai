{
  // The thing the Cloudflare dashboard cannot do for you.
  //
  // On the Workers FREE plan, Durable Objects must be SQLite-backed, which means the class has
  // to be registered by a `new_sqlite_classes` migration. Migrations are a lifecycle change and
  // are only applied by a wrangler deploy, never by the dashboard editor. So the dashboard's
  // "Add a Durable Object binding" dropdown, which lists classes that already exist, is empty
  // for a new class and stays empty however long you look for a create button.
  //
  // Deploy either way:
  //   no terminal : dashboard -> Workers -> Create -> Import a repository
  //                 repo grassyhilltop/tiny-ai, root directory staging/tiny-ai/tutor-bridge
  //   one command : npx wrangler deploy      (from this directory)
  "$schema": "node_modules/wrangler/config-schema.json",
  // MUST MATCH THE WORKER IT DEPLOYS TO. Cloudflare Builds names the Worker from the dashboard,
  // but `npx wrangler deploy` names it from here, so a mismatch quietly creates a SECOND Worker
  // at a different URL while the one you are testing never changes. The dashboard flags it
  // ("Update wrangler.jsonc in your repo to keep settings consistent"), which is worth heeding.
  "name": "tiny-ai",
  "main": "worker-do.js",
  "compatibility_date": "2025-04-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [
    // new_sqlite_classes, NOT new_classes: new_classes is the KV-backed kind and is paid-plan
    // only, and it fails with "you must create a namespace using a new_sqlite_classes
    // migration", which reads like a bug in your code and is not.
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
